# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Replace <user>, <password>, <host>, <port>, <database> with your PostgreSQL credentials.
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?schema=public"

# Set a strong, random session secret for your application.
SESSION_SECRET="<your-session-secret>"

# Sub-path de la app (sin slashes). Ej: "rag" → la app vive en /rag/
# Dejar vacio o no definir para que la app viva en la raiz /.
# IMPORTANTE: es una variable de build-time. Cambiarla requiere rebuild.
BASE_PATH=""

# Puerto del servidor Express (default: 3000)
PORT=3000
